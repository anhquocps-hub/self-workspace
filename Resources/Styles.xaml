<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ==================== -->
        <!-- COLORS / BRUSHES     -->
        <!-- ==================== -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF0F172A"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE5E7EB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF10B981"/>
        <!-- ==================== -->
        <!-- TEXT STYLES          -->
        <!-- ==================== -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

    <!-- Danger / Delete button -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#FFDC2626" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Status brushes -->
    <SolidColorBrush x:Key="StatusTodoBrush" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="StatusDoneBrush" Color="#FF10B981" />
    <!-- Deadline brushes -->
    <SolidColorBrush x:Key="DeadlineNormalBrush" Color="#FF6B7280" />
    <SolidColorBrush x:Key="DeadlineSoonBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="DeadlineOverdueBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="DeadlineCompletedBrush" Color="#FF10B981" />

    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{StaticResource StatusTodoBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="In Progress">
                <Setter Property="Fill" Value="{StaticResource StatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Fill" Value="{StaticResource StatusDoneBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
        <Style x:Key="CardTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="SubtleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- ==================== -->
        <!-- BUTTON               -->
        <!-- ==================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="10,6"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- ==================== -->
        <!-- PROJECT CARD         -->
        <!-- ==================== -->
        <Style x:Key="ProjectCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </ResourceDictionary>