<Window x:Class="workspace_hub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:workspace_hub.Controls"
        mc:Ignorable="d"

        Title="Workspace Hub"
        Height="600"
        Width="900"
        MinWidth="500"
        MinHeight="400">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<!-- Header -->
			<RowDefinition Height="Auto"/>

			<!-- Toolbar -->
			<RowDefinition Height="Auto"/>

			<!-- Project List -->
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<!-- =========================
             HEADER
             ========================= -->

		<Grid Grid.Row="0"
              Margin="0,0,0,16">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>


			<!-- App title -->
			<TextBlock Grid.Column="0"
                       Text="WORKSPACE HUB"
                       Style="{StaticResource HeaderText}"
                       VerticalAlignment="Center"/>


			<!-- Create new project -->
			<Button Grid.Column="1"
                    x:Name="NewProjectButton"
                    Content="+ New Project"
                    Style="{StaticResource PrimaryButton}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding NewProjectCommand}"/>

		</Grid>


		<!-- =========================
             TOOLBAR
             ========================= -->

		<WrapPanel Grid.Row="1"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   Margin="0,0,0,12">


			<!-- STATUS FILTER -->

			<StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,8">

				<TextBlock Text="Status:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>


				<Button x:Name="AllFilterButton"
                        Content="All (0)"
                        Click="StatusFilterButton_Click"
                        Margin="0,0,6,0"/>

				<Button x:Name="TodoFilterButton"
                        Content="Todo (0)"
                        Click="StatusFilterButton_Click"
                        Margin="0,0,6,0"/>

				<Button x:Name="InProgressFilterButton"
                        Content="In Progress (0)"
                        Click="StatusFilterButton_Click"
                        Margin="0,0,6,0"/>

				<Button x:Name="DoneFilterButton"
                        Content="Done (0)"
                        Click="StatusFilterButton_Click"/>

			</StackPanel>


			<!-- SORT -->

			<StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,8">

				<TextBlock Text="Sort:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>


				<ComboBox x:Name="SortComboBox"
                          Width="170"
                          SelectedIndex="0"
                          SelectionChanged="SortComboBox_SelectionChanged">

					<ComboBoxItem Content="Default"/>
					<ComboBoxItem Content="Deadline Earliest"/>
					<ComboBoxItem Content="Deadline Latest"/>

				</ComboBox>

			</StackPanel>

		</WrapPanel>


		<!-- =========================
             PROJECT AREA
             ========================= -->

		<Grid Grid.Row="2">


			<!-- PROJECT LIST -->

			<ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

				<ItemsControl ItemsSource="{Binding ProjectsView}">

					<!--
                        Project cards are placed horizontally.
                        When there is not enough space,
                        they automatically move to the next row.
                    -->

					<ItemsControl.ItemsPanel>

						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>

					</ItemsControl.ItemsPanel>


					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<controls:ProjectCard
                                Project="{Binding}"
                                OpenRequested="ProjectCard_OpenRequested"
                                EditRequested="ProjectCard_EditRequested"
                                DeleteRequested="ProjectCard_DeleteRequested"
                                ProjectChanged="ProjectCard_ProjectChanged"/>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</ScrollViewer>


			<!-- EMPTY STATE -->

			<TextBlock x:Name="EmptyStateTextBlock"
                       Text="No projects match your filters."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Visibility="Collapsed"/>

		</Grid>

	</Grid>

</Window>