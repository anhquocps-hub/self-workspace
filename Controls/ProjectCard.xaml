<UserControl x:Class="workspace_hub.Controls.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:workspace_hub.Converters">

    <UserControl.Resources>
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
    </UserControl.Resources>


    <Border Style="{StaticResource ProjectCardBorder}"
            Width="260"
            MinHeight="160"
            Margin="6">

        <StackPanel>

            <!-- Tên project -->
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource CardTitleText}" />

            <!-- Trạng thái with inline editor -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource StatusIndicatorStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="StatusComboBox"
                          Width="140"
                          SelectedValuePath="Content"
                          SelectionChanged="StatusComboBox_SelectionChanged"
                          VerticalAlignment="Center">
                    <ComboBoxItem>Todo</ComboBoxItem>
                    <ComboBoxItem>In Progress</ComboBoxItem>
                    <ComboBoxItem>Done</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <!-- Ghi chú -->
            <TextBlock Text="{Binding Note}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <!-- Deadline -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Deadline, StringFormat='Deadline: {0:dd/MM/yyyy}'}"
                           Style="{StaticResource SubtleText}" />
                <TextBlock x:Name="DeadlineStateText"
                           Text=""
                           Style="{StaticResource SubtleText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Folders header -->
            <TextBlock Text="{Binding FolderPaths.Count, StringFormat=Folders ({0})}"
                       Style="{StaticResource SubtleText}"
                       Margin="0,8,0,4" />

            <!-- Media header -->
            <TextBlock Text="Links &amp; media:" Style="{StaticResource SubtleText}" Margin="0,8,0,4" />

            <!-- No media placeholder -->
            <TextBlock Text="No links or media added"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MediaPaths.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Media list -->
            <ItemsControl ItemsSource="{Binding MediaPaths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBlock Text="🔗" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"
                                       Width="140" />
                            <Button Content="Open"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    Tag="{Binding}"
                                    Click="OpenMedia_Click" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No folders placeholder -->
            <TextBlock Text="No folders added"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FolderPaths.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Folder list -->
            <ItemsControl ItemsSource="{Binding FolderPaths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <!-- Primary marker -->
                            <TextBlock Text="★"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource EqToVis}">
                                        <Binding />
                                        <Binding Path="DataContext.PrimaryFolder" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>

                            <TextBlock Text="📁"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />

                            <TextBlock Text="{Binding}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"
                                       Width="140" />

                            <Button Content="Set Primary"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    Tag="{Binding}"
                                    Click="SetPrimary_Click">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource EqToVis}" ConverterParameter="Invert">
                                        <Binding />
                                        <Binding Path="DataContext.PrimaryFolder" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>

                            <Button Content="Open"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    Tag="{Binding}"
                                    Click="OpenFolder_Click" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open Workspace"
                        Style="{StaticResource PrimaryButton}"
                        Padding="8,4"
                        Click="OpenButton_Click" />

                <Button Content="Add Folder"
                        Margin="8,0,0,0"
                        Padding="8,4"
                        Click="AddFolder_Click" />
                <Button Content="Edit"
                        Margin="8,0,0,0"
                        Padding="8,4"
                        Click="EditButton_Click" />
                <Button Content="Delete"
                        Margin="8,0,0,0"
                        Padding="8,4"
                        Style="{StaticResource DangerButton}"
                        Click="DeleteButton_Click" />
            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>