<local:ProjectControl x:Class="workspace_hub.Controls.ProjectCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:workspace_hub.Controls" VerticalAlignment="Top">
    <Border Style="{StaticResource ProjectCardBorder}" Width="260" Margin="6">
        <StackPanel>
            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Summary_MouseLeftButtonUp">
                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Style="{StaticResource StatusIndicatorStyle}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Status}" />
                </StackPanel>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                           ToolTip="{Binding Note}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Deadline, StringFormat='Deadline: {0:dd/MM/yyyy}'}"
                           Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                <TextBlock x:Name="DeadlineStateText" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding MediaPaths.Count, StringFormat='Links &amp; media ({0})'}"
                               Style="{StaticResource SubtleText}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding FolderPaths.Count, StringFormat='Folders ({0})'}"
                               Style="{StaticResource SubtleText}" />
                </WrapPanel>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenProjectButton" Content="Open Project" Style="{StaticResource PrimaryButton}"
                        Padding="8,4" Click="OpenButton_Click" />
                <Button x:Name="DetailsButton" Grid.Column="1" Content="Details" Margin="8,0,0,0"
                        Padding="8,4" Click="DetailsButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</local:ProjectControl>