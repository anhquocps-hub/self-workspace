<local:ProjectControl x:Class="workspace_hub.Controls.ProjectDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:workspace_hub.Controls"
    xmlns:conv="clr-namespace:workspace_hub.Converters">
    <local:ProjectControl.Resources>
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
    </local:ProjectControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Style="{StaticResource StatusIndicatorStyle}" Margin="0,0,8,0" />
                    <ComboBox x:Name="StatusComboBox" Width="160" SelectedValuePath="Content"
                        SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                        SourceUpdated="Status_SourceUpdated">
                        <ComboBoxItem>Todo</ComboBoxItem>
                        <ComboBoxItem>In Progress</ComboBoxItem>
                        <ComboBoxItem>Done</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Deadline, StringFormat='Deadline: {0:dd/MM/yyyy}'}"
                           Style="{StaticResource SubtleText}" Margin="0,12,0,0" />
                <TextBlock x:Name="DeadlineStateText" Style="{StaticResource SubtleText}" />
                <TextBlock Text="{Binding MediaPaths.Count, StringFormat='Links &amp; media ({0})'}"
                           FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="No links or media added">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MediaPaths.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding MediaPaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Open" Tag="{Binding}" Click="OpenMedia_Click" Margin="8,0,0,0" Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding FolderPaths.Count, StringFormat='Folders ({0})'}"
                           FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="No folders added">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FolderPaths.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding FolderPaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x2605;" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource EqToVis}">
                                                <Binding />
                                                <Binding Path="Project.PrimaryFolder" RelativeSource="{RelativeSource AncestorType={x:Type local:ProjectDetails}}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Open" Tag="{Binding}" Click="OpenFolder_Click" Margin="8,0,0,0" Padding="8,4" />
                                </Grid>
                                <Button Content="Set Primary" Tag="{Binding}" Click="SetPrimary_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,4">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource EqToVis}" ConverterParameter="Invert">
                                            <Binding />
                                            <Binding Path="Project.PrimaryFolder" RelativeSource="{RelativeSource AncestorType={x:Type local:ProjectDetails}}" />
                                        </MultiBinding>
                                    </Button.Visibility>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel x:Name="ActionsPanel" Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Open Project" Click="OpenButton_Click" Style="{StaticResource PrimaryButton}" Padding="8,4" Margin="0,0,8,6" />
            <Button Content="Add Folder" Click="AddFolder_Click" Padding="8,4" Margin="0,0,8,6" />
            <Button Content="Edit" Click="EditButton_Click" Padding="8,4" Margin="0,0,8,6" />
            <Button Content="Delete" Click="DeleteButton_Click" Style="{StaticResource DangerButton}" Padding="8,4" Margin="0,0,8,6" />
            <Button Content="Close" Click="CloseButton_Click" Padding="8,4" Margin="0,0,0,6" />
        </WrapPanel>
    </Grid>
</local:ProjectControl>