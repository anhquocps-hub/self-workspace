<Window x:Class="workspace_hub.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Project" Height="320" Width="420" WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Project" Style="{StaticResource HeaderText}" />

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="Name" />
            <TextBox x:Name="NameTextBox" />

            <TextBlock Text="Note" Margin="0,8,0,0" />
            <TextBox x:Name="NoteTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel Width="200">
                    <TextBlock Text="Status" />
                    <ComboBox x:Name="StatusComboBox">
                        <ComboBoxItem>Todo</ComboBoxItem>
                        <ComboBoxItem>In Progress</ComboBoxItem>
                        <ComboBoxItem>Done</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Deadline" />
                    <DatePicker x:Name="DeadlinePicker" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save Changes" x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Padding="10,6" />
            <Button Content="Cancel" Margin="8,0,0,0" Click="CancelButton_Click" Padding="10,6" />
        </StackPanel>

    </Grid>
</Window>
